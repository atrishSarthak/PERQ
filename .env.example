# Neon Postgres connection string. Get one at https://neon.tech (free tier).
DATABASE_URL=

# Auth.js session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth credentials. Create at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application"). Redirect URI:
# <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini API key (free tier). Get one at https://aistudio.google.com/apikey
# PRD §15: confirm the exact model identifier and current free-tier quota
# (RPM/RPD/TPM) in Google AI Studio at implementation time — don't hardcode
# a number that will go stale.
GEMINI_API_KEY=

# Jina AI Reader API key (optional). Feature 3's precision-fetch step uses
# https://r.jina.ai to fetch a specific listing page when Gemini's grounded
# search alone didn't surface a firm price. Works unauthenticated at a lower
# free rate — get a free key at https://jina.ai/reader/ for a higher rate.
JINA_API_KEY=
