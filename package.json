{
  "name": "perq",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @perq/web dev",
    "dev:mobile": "pnpm --filter @perq/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "eval": "pnpm --filter @perq/web eval",
    "db:generate": "pnpm --filter @perq/db db:generate",
    "db:migrate": "pnpm --filter @perq/db db:migrate",
    "db:seed-cards": "pnpm --filter @perq/db db:seed-cards",
    "statements:fake": "pnpm --filter @perq/statements fake",
    "nudges:run": "pnpm --filter @perq/web nudges:run",
    "eval:statements": "pnpm --filter @perq/statements eval",
    "eval:money": "pnpm --filter @perq/web eval:money"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
